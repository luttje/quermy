{
    "name": "quermy/quermy",
    "description": "A drop-in SQL companion for W/LAMP stacks with a modern Svelte UI and BYOK (Bring Your Own Key) AI assistance for query writing and schema exploration.",
    "type": "project",
    "license": "MIT",
    "scripts": {
        "test": "./vendor/bin/pest"
    },
    "require": {
        "php": ">=8.3",
        "symfony/ai-agent": "^0.8.0",
        "symfony/ai-anthropic-platform": "^0.8.1",
        "symfony/ai-bundle": "^0.8.0",
        "symfony/ai-open-ai-platform": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.6",
        "testcontainers/testcontainers": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Quermy\\": "src/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    }
}
