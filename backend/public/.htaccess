# Quermy — Apache configuration
# Drop into a LAMP environment, point a vhost (or alias) at this directory.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite real files / directories (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # API requests go through the PHP front controller
    RewriteRule ^api/.*$ index.php [L,QSA]

    # Health check endpoint /health
    RewriteRule ^health$ health.php [L,QSA]

    # Everything else is the SPA — serve index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Sensible defaults
Options -Indexes
