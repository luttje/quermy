# Quermy — Apache configuration
# Drop into a LAMP environment, point a vhost (or alias) at this directory.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite real files / directories (CSS, JS, images, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # API requests go through the PHP front controller
    RewriteRule ^api/.*$ index.php [L,QSA]

    # Health check endpoint /health
    RewriteRule ^health$ health.php [L,QSA]

    # Everything else is the SPA — serve index.html
    RewriteRule ^ index.html [L]
</IfModule>

# Security headers for everything served from here (the Content Security
# Policy itself is set by a <meta> tag in index.html).
<IfModule mod_headers.c>
    # Don't let browsers guess content types
    Header always set X-Content-Type-Options "nosniff"
    # Never render Quermy inside another site's frame (clickjacking)
    Header always set X-Frame-Options "DENY"
    # Don't leak Quermy URLs to sites opened from it
    Header always set Referrer-Policy "no-referrer"
</IfModule>

# Sensible defaults
Options -Indexes
